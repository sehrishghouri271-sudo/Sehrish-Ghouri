/* =========================
   BASIC SETTINGS
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f6f1e8;
    color: #29251f;
    font-family: "Playfair Display", serif;
    line-height: 1.7;
}


/* =========================
   NAVBAR
========================= */

.navbar {
    height: 75px;
    background: #3f5142;
    color: #fffdf8;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 7%;
    direction: ltr;

    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 21px;
    letter-spacing: 1px;
}

.navbar nav {
    display: flex;
    gap: 30px;
}

.navbar a {
    color: #fffdf8;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
}

.navbar a:hover {
    color: #b89b72;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 85vh;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 80px 20px;

    background:
        linear-gradient(
            rgba(246, 241, 232, 0.75),
            rgba(246, 241, 232, 0.95)
        ),
        url("images/hero.jpg");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 800px;
}

.small-heading {
    font-size: 12px;
    letter-spacing: 4px;
    color: #8a765c;
    direction: ltr;
    margin-bottom: 25px;
}

.hero h1 {
    font-family: "Noto Nastaliq Urdu", serif;
    font-size: clamp(42px, 7vw, 80px);
    font-weight: 400;
    line-height: 1.7;
    color: #3f5142;
}

.hero-text {
    font-family: "Noto Nastaliq Urdu", serif;
    font-size: 20px;
    max-width: 650px;
    margin: 20px auto 35px;
}


/* =========================
   BUTTON
========================= */

.button {
    display: inline-block;

    background: #3f5142;
    color: #fffdf8;

    padding: 12px 28px;

    text-decoration: none;

    border-radius: 2px;

    transition: 0.3s;
}

.button:hover {
    background: #29251f;
    transform: translateY(-2px);
}


/* =========================
   GENERAL SECTIONS
========================= */

section {
    padding: 110px 8%;
}

.section-label {
    direction: ltr;
    text-align: left;

    font-size: 11px;
    letter-spacing: 4px;

    color: #8a765c;

    margin-bottom: 20px;
}


/* =========================
   ABOUT
========================= */

.about {
    background: #fffdf8;
}

.about-content {
    max-width: 850px;
}

.about-text {
    direction: ltr;
    text-align: left;
}

.about h2 {
    font-size: 45px;
    color: #3f5142;
    margin-bottom: 25px;
}

.about p {
    font-size: 16px;
    margin-bottom: 18px;
    max-width: 750px;
}

.text-link {
    display: inline-block;
    color: #3f5142;
    text-decoration: none;
    margin-top: 10px;
    border-bottom: 1px solid #b89b72;
}


/* =========================
   NAYAB
========================= */

.nayab {
    background: #e9e4d8;
    text-align: center;
}

.nayab-content {
    max-width: 850px;
    margin: auto;
}

.nayab h2 {
    font-family: "Noto Nastaliq Urdu", serif;
    font-size: clamp(45px, 7vw, 75px);
    font-weight: 400;
    color: #3f5142;

    margin-bottom: 35px;
}

.urdu-description {
    direction: rtl;

    font-family: "Noto Nastaliq Urdu", serif;
    font-size: 19px;

    line-height: 2.6;
}

.urdu-description p {
    margin-bottom: 18px;
}

.urdu-description .ending {
    color: #3f5142;
    font-size: 23px;
    margin-top: 30px;
}


/* =========================
   EPISODE
========================= */

.episode {
    background: #3f5142;
    color: #fffdf8;
    text-align: center;
}

.episode .section-label {
    color: #b89b72;
    text-align: center;
}

.episode h2 {
    font-family: "Noto Nastaliq Urdu", serif;
    font-size: 42px;
    font-weight: 400;
    margin-bottom: 10px;
}

.episode p {
    margin-bottom: 20px;
}

.episode .text-link {
    color: #fffdf8;
}


/* =========================
   WRITING
========================= */

.writing {
    background: #f6f1e8;
}

.writing h2 {
    font-size: 45px;
    color: #3f5142;
    margin-bottom: 50px;
    direction: ltr;
}

.writing-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 20px;

    direction: ltr;
}

.writing-card {
    background: #fffdf8;

    padding: 35px 25px;

    min-height: 220px;

    border: 1px solid #ded7c9;

    transition: 0.3s;
}

.writing-card:hover {
    transform: translateY(-5px);
}

.writing-card span {
    color: #b89b72;
    font-size: 12px;
}

.writing-card h3 {
    color: #3f5142;
    margin: 20px 0 10px;
}

.writing-card p {
    font-size: 14px;
}


/* =========================
   CONTACT
========================= */

.contact {
    background: #fffdf8;
    text-align: center;
}

.contact .section-label {
    text-align: center;
}

.contact h2 {
    font-size: 45px;
    color: #3f5142;
    margin-bottom: 15px;
}

.contact p {
    margin-bottom: 30px;
}

.socials {
    display: flex;
    justify-content: center;
    gap: 30px;
    direction: ltr;
}

.socials a {
    color: #3f5142;
    text-decoration: none;
    border-bottom: 1px solid #b89b72;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #29251f;
    color: #fffdf8;

    text-align: center;

    padding: 55px 20px;
}

.footer-name {
    font-size: 23px;
    margin-bottom: 5px;
}

footer p {
    font-size: 13px;
    opacity: 0.8;
}

.copyright {
    margin-top: 25px;
    font-size: 11px;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

    .navbar {
        padding: 0 5%;
    }

    .navbar nav {
        gap: 12px;
    }

    .navbar nav a {
        font-size: 11px;
    }

    .logo {
        font-size: 17px;
    }

    section {
        padding: 80px 6%;
    }

    .writing-grid {
        grid-template-columns: 1fr 1fr;
    }

    .hero h1 {
        font-size: 45px;
    }

    .urdu-description {
        font-size: 17px;
    }
}


@media (max-width: 500px) {

    .navbar {
        height: auto;
        padding: 18px;
        flex-direction: column;
        gap: 12px;
    }

    .navbar nav {
        flex-wrap: wrap;
        justify-content: center;
    }

    .writing-grid {
        grid-template-columns: 1fr;
    }

    .hero {
        min-height: 75vh;
    }

    .about h2,
    .writing h2,
    .contact h2 {
        font-size: 34px;
    }

    .hero-text {
        font-size: 17px;
    }
}
