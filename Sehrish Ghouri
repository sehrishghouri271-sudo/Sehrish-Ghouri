        <div class="writing-grid">

            <div class="writing-card">
                <span>01</span>
                <h3>Novels</h3>
                <p>Urdu novels and episodic stories.</p>
            </div>

            <div class="writing-card">
                <span>02</span>
                <h3>Afsane</h3>
                <p>Short stories and little worlds of their own.</p>
            </div>

            <div class="writing-card">
                <span>03</span>
